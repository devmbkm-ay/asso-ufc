# ── Base de données ───────────────────────────────────────────────────────────
# En dev local (docker-compose) : utilise le service "db"
# En prod (Hetzner) : pointe vers PostgreSQL sur le même VPS ou un service managé
DATABASE_URL=postgresql://asso_user:changeme@db:5432/asso_db

POSTGRES_DB=asso_db
POSTGRES_USER=asso_user
POSTGRES_PASSWORD=changeme         # ← CHANGER EN PROD (mot de passe fort)

# ── JWT ───────────────────────────────────────────────────────────────────────
# Générer une clé forte : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-strong-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Application ───────────────────────────────────────────────────────────────
DEBUG=false
ALLOWED_ORIGINS=https://asso.tondomaine.fr,http://localhost:3000

# ── Email (Brevo) ─────────────────────────────────────────────────────────────
BREVO_API_KEY=
EMAIL_FROM=noreply@tondomaine.fr
EMAIL_FROM_NAME=Association Mboka
